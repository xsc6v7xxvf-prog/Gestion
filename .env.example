# Cadena de conexión de PostgreSQL (Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://usuario:password@host:5432/gestion?sslmode=require"

# NextAuth
# Genera un valor con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET="reemplaza-con-un-valor-secreto-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# SMTP para envío de emails (recuperación de contraseña)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="usuario@example.com"
SMTP_PASSWORD="password"
EMAIL_FROM="Gestion Serviprac <no-reply@example.com>"
